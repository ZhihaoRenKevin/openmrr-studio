{
  "name": "OpenMRR Studio (Cloud Browser Workbench)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --upgrade pip && pip install -e .",
  "postAttachCommand": {
    "openmrr-web": "openmrr browser --no-open --port 8765"
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "OpenMRR Studio Web Workbench",
      "onAutoForward": "openBrowser"
    }
  }
}
